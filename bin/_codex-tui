#!/usr/bin/env bash
# bin/_codex-tui — 由 bin/spawn-agent 在 tmux window 裡呼叫，不要直接用
#
#   bin/_codex-tui <模型> <初始 prompt 檔>
#
# 用 exec：tmux 的前景程式才會是 codex 本身（不是這支 bash 腳本），bin/watch 等才能正確判斷。
# exec 只取代本腳本，codex 結束後仍回到 window 的 shell，可在同一 window 重開（見 AGENT.md §2.7）。

. "$(dirname "$0")/_lib.sh"

[ $# -eq 2 ] || die "用法：bin/_codex-tui <模型> <prompt 檔>"
model="$1" prompt_file="$2"
[ -n "$model" ] || die "未指定模型（不可省略 -m）"

exec "$CODEX_BIN" -m "$model" \
  -s workspace-write \
  -a "$CODEX_APPROVAL" \
  --add-dir "$TEAM_STATE" \
  --no-alt-screen \
  "$(cat "$prompt_file")"
