#!/usr/bin/env bash
# bin/review — 以唯讀沙箱跑一次 review-rd（codex exec -s read-only），請用背景執行
#
#   bin/review <proj> <專案目錄名> <slug> <模型> <effort> [輪次=1]
#
# - 每次審查都是全新的 codex（第 2 輪起會先讀上一輪報告），由沙箱保證唯讀、不會出現核准畫面。
# - 報告取自 codex 的最後回覆（-o）：第 1 輪建立 review 檔，第 2 輪起 append 到同一檔。
# - 結束後由本腳本代寫 EVENTS.log：DONE review-rd[@<ws>] <proj> <slug> <檔> PASS|FAIL …；失敗寫 BLOCKED。
# - codex 的完整輸出存在 $LOGS/review-<proj>-<slug>-r<N>.log
# - 開審前工作區指紋必須等於 <proj>-rd 最後一次 DONE 的 fp，審完再比一次；不符寫 BLOCKED。
#   DONE 事件帶 fp=，代表這份審查結果只對應這個版本的工作區。
# - 有同一 fp 的 bin/verify 結果時，一併交給 review-rd 當作編譯與測試的依據。

. "$(dirname "$0")/_lib.sh"
need_state
need_proj_root

[ $# -ge 5 ] || die "用法：bin/review <proj> <專案目錄名> <slug> <模型> <effort> [輪次]"
proj="$1" dir="$2" slug="$3" model="$4" effort="$5" round="${6:-1}"
[ -n "$model" ] || die "未指定模型（必須先問使用者，不可省略）"
check_effort "$effort"

cwd="$PROJ_ROOT/$dir"
task="$TEAM_STATE/tasks/$proj-$slug.md"
handoff="$TEAM_STATE/handoff/$proj-rd-$slug.md"
role="$TEAM_STATE/roles/$proj-rd.md"
report="$TEAM_STATE/handoff/review-$proj-$slug.md"
report_rel="handoff/review-$proj-$slug.md"
log="$LOGS/review-$proj-$slug-r$round.log"
out="$LOGS/review-$proj-$slug-r$round.out.md"
log_rel="${log#$TEAM_STATE/}"
out_rel="${out#$TEAM_STATE/}"

for f in "$task" "$handoff" "$role"; do [ -f "$f" ] || die "找不到：$f"; done
[ -d "$cwd" ] || die "專案目錄不存在：$cwd"
if [ "$round" = 1 ]; then
  [ ! -e "$report" ] || die "第 1 輪但 review 檔已存在：${report}（第 2 輪起請指定輪次）"
else
  [ -f "$report" ] || die "第 $round 輪但找不到前一輪報告：$report"
fi

event_agent="$(ws_agent review-rd)"
blocked() { "$TEAM_ROOT/bin/event" BLOCKED "$event_agent" "$proj" "$slug" - "$*"; exit 1; }

base="$(task_base "$task")"
[ -n "$base" ] || die "任務書缺 base commit：$task"
fp="$(work_fp "$cwd" "$base")" || blocked "算不出工作區指紋：$cwd"
done_fp="$(last_event_fp DONE "$proj-rd" "$proj" "$slug")"
[ "$fp" = "$done_fp" ] ||
  blocked "工作區指紋 $fp 與 $proj-rd 最後一次 DONE 的 fp=${done_fp:-（無）} 不同：DONE 後又改過，先讓 agent 重新交件"

verify_report="$TEAM_STATE/handoff/verify-$proj-$slug.md"
if [ -f "$verify_report" ] && [ "$(last_event_fp DONE verify "$proj" "$slug")" = "$fp" ]; then
  verify_line="- lead 重跑的編譯與測試結果（bin/verify，與本次審查同一個工作區）：$verify_report"
else
  verify_line="- 沒有對應本次工作區的 bin/verify 結果：handoff 裡的編譯與測試結果只是 agent 自述，請寫進「未能審查的部分」"
fi

prev=""
[ "$round" = 1 ] || prev="- 前幾輪審查報告：${report}（先讀它，本輪只輸出「第 $round 輪」一節）"

prompt="$(cat <<EOF
請先閱讀 $TEAM_ROOT/roles/review-rd.md，並全程遵守其中規範。然後執行一次審查：

- 審查輪次：第 $round 輪
- 專案：${proj}，專案目錄：$cwd
- 任務書：${task}（含「派工基準」：base commit 與派工前已存在的改動）
- 開發 agent 的 handoff：$handoff
- 專案 role（含專案硬規範）：$role
- 報告格式：$TEAM_ROOT/templates/handoff-review.md
$verify_line
$prev

你在唯讀沙箱裡，不能寫任何檔案。報告請直接作為你的最後一則回覆輸出（完整 Markdown），
最後一行必須是：RESULT: PASS|FAIL <N> Blocker <M> Major <K> Minor
EOF
)"

mkdir -p "$LOGS" "$TEAM_STATE/handoff"
rm -f "$out"
echo "審查中：$proj $slug 第 $round 輪（模型 ${model}，effort ${effort}，fp=${fp}），log：$log"

set +e
"$CODEX_BIN" exec -m "$model" -c "model_reasoning_effort=\"$effort\"" -s read-only -C "$cwd" -o "$out" "$prompt" </dev/null >"$log" 2>&1
rc=$?
set -e

if [ "$rc" -ne 0 ] || [ ! -s "$out" ]; then
  blocked "codex exec 失敗 rc=${rc}，見 $log_rel"
fi

after="$(work_fp "$cwd" "$base" || echo error)"
[ "$after" = "$fp" ] ||
  blocked "審查期間工作區有變動（fp $fp → ${after}），本輪報告作廢，見 $out_rel"

result="$({ grep -E '^RESULT: (PASS|FAIL)' "$out" || true; } | tail -1 | sed 's/^RESULT: //')"
if [ -z "$result" ]; then
  result="UNKNOWN 報告缺 RESULT 行，請 lead 人工判讀"
fi

if [ "$round" = 1 ]; then
  cp "$out" "$report"
else
  { printf '\n\n---\n\n'; cat "$out"; } >> "$report"
fi

"$TEAM_ROOT/bin/event" DONE "$event_agent" "$proj" "$slug" "$report_rel" "$result fp=$fp"
